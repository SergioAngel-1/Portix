[Desktop Entry]
Type=Application
Name=Portix
GenericName=Port Explorer
Comment=See what's running on your ports and which project it belongs to
Exec=@PORTIX_LAUNCH@
TryExec=@PORTIX_BIN@
Icon=portix
Terminal=@PORTIX_TERMINAL_FLAG@
Categories=Development;
Keywords=ports;sockets;netstat;services;development;
StartupNotify=false
X-Portix-Managed=true
Actions=Update;

[Desktop Action Update]
Name=Update Portix
Exec=@PORTIX_UPDATE@
