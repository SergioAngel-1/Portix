# Maintainer: Sergio Jáuregui <owner@sergioja.com>
pkgname=portix-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="The local development service explorer — lists listening sockets and infers the project each belongs to"
arch=('x86_64' 'aarch64')
url="https://github.com/SergioAngel-1/Portix"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs')
makedepends=('git' 'cargo')
optdepends=('xdg-utils: open a service URL in the browser (the "o" key)'
            'wl-clipboard: copy a service URL on Wayland (the "y" key)'
            'xclip: copy a service URL on X11 (the "y" key)')
provides=('portix')
conflicts=('portix')
source=("$pkgname::git+https://github.com/SergioAngel-1/Portix.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$pkgname"
    # <crate-version>.r<commit-count>.g<short-hash>, sorted correctly by pacman.
    printf "%s.r%s.g%s" \
        "$(awk -F '"' '/^version[[:space:]]*=/ {print $2; exit}' Cargo.toml)" \
        "$(git rev-list --count HEAD)" \
        "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    # Vendor dependencies against the committed Cargo.lock so the build is offline.
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$srcdir/$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$srcdir/$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    # The suite is hermetic: it drives synthetic /proc trees, no privileges needed.
    cargo test --frozen --release
}

package() {
    cd "$srcdir/$pkgname"

    install -Dm0755 "target/release/portix" "$pkgdir/usr/bin/portix"

    # Shell completions, generated by the binary itself.
    install -dm0755 "$pkgdir/usr/share/bash-completion/completions"
    ./target/release/portix --completions bash \
        > "$pkgdir/usr/share/bash-completion/completions/portix"
    install -dm0755 "$pkgdir/usr/share/zsh/site-functions"
    ./target/release/portix --completions zsh \
        > "$pkgdir/usr/share/zsh/site-functions/_portix"
    install -dm0755 "$pkgdir/usr/share/fish/vendor_completions.d"
    ./target/release/portix --completions fish \
        > "$pkgdir/usr/share/fish/vendor_completions.d/portix.fish"

    # Dual-licensed: install both texts.
    install -Dm0644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm0644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
